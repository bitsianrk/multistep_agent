# Copy this file to .env (same folder) and fill in your values. .env is git-ignored:
# never commit real credentials.
#   Windows:        copy .env.example .env
#   macOS / Linux:  cp .env.example .env
#
# Tesco Analytics EA Garage LRM - same API as the PR coupon design agent. Needs the Tesco VPN.
LRM_EMPLOYEE_ID=
LRM_API_KEY=
LRM_MODEL=o4-mini
# LRM_BASE_URL=https://www.ourtesco.com/analytics/eagarage-toolkit/api/azure-openai
# LRM_TIMEOUT_S=240
# LRM_RETRIES=3

# live (default for the UI and CLI) | simulated (offline demo) | off (rules only) | auto
LRM_MODE=live
